# 新攻略服务；此文件仅为无秘密示例，不是旧库迁移目标。
# 原生启动与 Alembic 使用这项；密码特殊字符须 URL 编码。
GUIDE_DATABASE_URL=
# 32+ 字节、部署后固定。旋转会重置匿名 IP 限额识别。
GUIDE_IP_HASH_KEY=
# 仅 Docker Compose：使用独立数据卷，连接串主机应为 postgres。
GUIDE_POSTGRES_PASSWORD=
GUIDE_COMPOSE_DATABASE_URL=
GUIDE_TLS_DIR=./build/local-tls
GUIDE_PORT=8443
# 通用 Responses 模型仅由服务器配置；不分发给客户端。
LLM_API_STYLE=responses
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_STRUCTURED_OUTPUTS=false
# 仅离线迁移工具只读源，平时不要设置。
GUIDE_LEGACY_DATABASE_URL=
# 仅隔离验收，不指向任何业务库。
TEST_DATABASE_URL=
