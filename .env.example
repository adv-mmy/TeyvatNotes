# 复制为 .env 后填入自己的凭据；不要提交真实 .env。
# API Key 可用：python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_RUNTIME_API_KEY=
POSTGRES_PASSWORD=

POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
AGENT_RUNTIME_PORT=8000
AGENT_RUNTIME_EXECUTION_MODE=api_only
AGENT_RUNTIME_WORKER_COUNT=4
AGENT_RUNTIME_MAX_CONCURRENCY=2
AGENT_RUNTIME_TASK_TIMEOUT_SECONDS=30
AGENT_RUNTIME_SHUTDOWN_TIMEOUT_SECONDS=5
AGENT_RUNTIME_RATE_LIMIT_REQUESTS=30
AGENT_RUNTIME_RATE_LIMIT_WINDOW_SECONDS=60
# 留空时使用 hostname-pid，避免多个 Worker 共用固定身份。
AGENT_RUNTIME_WORKER_ID=
AGENT_RUNTIME_WORKER_POLL_INTERVAL_SECONDS=0.2
AGENT_RUNTIME_WORKER_LEASE_DURATION_SECONDS=45
AGENT_RUNTIME_MAX_ATTEMPTS=3
AGENT_RUNTIME_RETRY_BASE_DELAY_SECONDS=1
AGENT_RUNTIME_RETRY_MAX_DELAY_SECONDS=30
AGENT_RUNTIME_RETRY_JITTER_RATIO=0.2
# Worker 独立的本机监控端口；Compose 不将此端口发布到宿主机。
AGENT_RUNTIME_WORKER_MONITOR_HOST=127.0.0.1
AGENT_RUNTIME_WORKER_MONITOR_PORT=9101
# 仅供本机测试，必须指向可丢弃数据库；密码需 URL 编码。
TEST_DATABASE_URL=

# 私有攻略会话的持久所有者分区标识；不是认证凭据，不影响 Task API。
# 生成一次并保留：python -c "import uuid; print(uuid.uuid4())"
GUIDE_SESSION_OWNER_ID=

# 攻略问答 CLI 专用，不改变 Task API/Worker；只填轮换后的本机密钥。
# 选择支持 Responses API 的服务商；地址和模型必须自行填写，无厂商默认值。
# LLM_BASE_URL 可为 API 基址（例如 https://llm.example.com/v1）或完整 /responses 地址。
LLM_API_STYLE=responses
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# 仅在服务商和模型确认支持 text.format 后开启；默认本地严格校验 JSON。
LLM_STRUCTURED_OUTPUTS=false
